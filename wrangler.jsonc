{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "dev-agency-landing-v1",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dev-agency-landing-v1"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "CONTACT_TO_EMAIL": "hello@runmadeagency.com",
    "CONTACT_FROM_EMAIL": "Runmade <noreply@runmadeagency.com>"
  },
  "observability": {
    "enabled": true
  }
}
